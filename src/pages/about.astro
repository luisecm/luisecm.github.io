---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { site, tone, experience, education, capabilities } from "../data/site";

const principles = [
  {
    title: "A retry is not a fix",
    body: "If a test is flaky, something is genuinely non-deterministic — a race condition, a shared fixture, an assertion against a promise the app never made. Adding a retry hides it and teaches your team to ignore red builds.",
  },
  {
    title: "Coverage percentage is a vanity metric",
    body: "I'd rather have fifteen tests that cover the journeys your revenue depends on than four hundred that assert a button is still blue. Risk decides what gets automated, not a target number.",
  },
  {
    title: "Tests your team won't maintain are worthless",
    body: "I write test code to the standard of production code and review it the same way, because a suite that becomes unmaintainable gets deleted — usually about a quarter after the consultant leaves.",
  },
  {
    title: "Quality is not a gate at the end",
    body: "The cheapest bug is the one caught while the feature is still being designed. I'd rather be in the requirements conversation than handed a release candidate on a Friday.",
  },
];
---

<Base
  path="/about"
  title="About"
  description="Luis Cardeña — SDET with 14 years in quality engineering across web, mobile, desktop and Web3 applications. Based in Mérida, Mexico, working with distributed teams worldwide."
>
  <Section eyebrow="About" title="Luis Cardeña"
    as="h1" class="!pt-20 md:!pt-24">
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div class="reveal space-y-5 text-lg leading-relaxed text-ink-soft">
        <p>
          I'm a QA engineer and SDET, and I've been doing this for fourteen
          years. I started in manual testing on desktop and IVR systems, moved
          into data and ETL validation where a wrong number means someone's
          payment is wrong, then into automation — web, then mobile, then desktop,
          then decentralised applications where almost nothing behaves the way the
          documentation promises.
        </p>
        <p>
          Along the way I've led small distributed test teams, built frameworks
          from nothing, and spent a lot of time on the specific problem of making
          a test suite that a team still trusts a year later. That last part is
          the hard bit, and it's mostly what people hire me for.
        </p>
        <p>
          These days I also build products. I take on feature work and whole
          applications, usually with an AI assistant in the loop from first
          prototype through to release. I like the combination: knowing how to
          break things well makes me better at building them, and shipping my own
          software keeps me honest about what
          <em class="text-ink not-italic">well-tested</em> actually has to mean
          when there's a deadline.
        </p>
        <p>
          I'm based in {site.location}, which puts me in a full working-day
          overlap with teams across the US and Latin America. I've worked remotely
          with distributed teams for most of the last decade.
        </p>
      </div>

      <div class="reveal card h-fit p-6">
        <p class="eyebrow">At a glance</p>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="text-muted">Focus</dt>
            <dd class="mt-0.5 text-ink">
              Test automation, CI/CD, release quality
            </dd>
          </div>
          <div>
            <dt class="text-muted">Also</dt>
            <dd class="mt-0.5 text-ink">
              Product engineering, AI-assisted builds
            </dd>
          </div>
          <div>
            <dt class="text-muted">Platforms</dt>
            <dd class="mt-0.5 text-ink">Web, iOS, Android, desktop, Web3</dd>
          </div>
          <div>
            <dt class="text-muted">Based in</dt>
            <dd class="mt-0.5 text-ink">{site.location}</dd>
          </div>
          <div>
            <dt class="text-muted">Hours</dt>
            <dd class="mt-0.5 text-ink">{site.timezone}</dd>
          </div>
          <div>
            <dt class="text-muted">Languages</dt>
            <dd class="mt-0.5 text-ink">Spanish (native), English (fluent)</dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <!-- ── Principles ───────────────────────────────────────── -->
  <Section
    eyebrow="How I think about it"
    title="Four opinions I'll bring with me"
    class="border-t border-line"
  >
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        principles.map((item) => (
          <article class="reveal card p-7">
            <h3 class="text-lg font-semibold tracking-tight text-accent">
              {item.title}
            </h3>
            <p class="mt-3 leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ── Experience ───────────────────────────────────────── -->
  <Section
    eyebrow="Experience"
    title="Fourteen years, seven teams"
    lede="Employers are described by sector rather than named — current clients and roles stay confidential. Happy to talk specifics on a call."
    class="border-t border-line"
  >
    <ol class="mt-12 border-l border-line">
      {
        experience.map((job) => (
          <li class="reveal relative pb-10 pl-7 last:pb-0">
            <span
              class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 rounded-full border-2 border-paper bg-ink"
              aria-hidden="true"
            />
            <p class="text-xs text-muted">{job.period}</p>
            <h3 class="mt-1.5 text-lg font-semibold tracking-tight">{job.title}</h3>
            <p class="mt-0.5 text-sm text-accent">{job.org}</p>
            <p class="mt-2 max-w-2xl leading-relaxed text-muted">{job.note}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ── Education + toolkit ──────────────────────────────── -->
  <Section class="border-t border-line">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Education</p>
        <ol class="mt-6 space-y-6">
          {
            education.map((item) => (
              <li>
                <p class="text-xs text-muted">{item.period}</p>
                <h3 class="mt-1.5 font-semibold tracking-tight">{item.title}</h3>
                <p class="mt-0.5 text-sm text-muted">{item.org}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="reveal">
        <p class="eyebrow">Toolkit</p>
        <div class="mt-6 space-y-5">
          {
            capabilities.map((group) => (
              <div>
                <h3 class="text-sm font-semibold text-ink">{group.title}</h3>
                <ul class="mt-2.5 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <li
                      class="rounded-md border border-line bg-surface px-2 py-1 text-[0.7rem] text-ink-soft"
                    >
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <CtaBlock
    heading="Think I'd be useful?"
    lede={tone.aboutClosing}
  />
</Base>
