---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { caseStudiesByRecency } from "../data/site";
---

<Base
  path="/work"
  title="Work"
  description="Case studies in test automation and quality engineering across Web3 messaging, enterprise commerce, insurance data pipelines and client product builds."
>
  <Section
    eyebrow="Case studies"
    title="Work, with the detail left in"
    as="h1"
    lede="Client names are withheld where the engagement is under NDA — described by sector instead. The open-source work is named, public, and you can read every line of it."
    class="!pt-20 md:!pt-24"
  />

  <div class="shell space-y-6 pb-12">
    {
      caseStudiesByRecency.map((study) => (
        <article id={study.slug} class="reveal card scroll-mt-24 p-7 md:p-10">
          <header
            class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3 border-b border-line pb-6"
          >
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                <h2 class="text-2xl font-semibold tracking-tight">{study.client}</h2>
                <span
                  class:list={[
                    "rounded-full border px-2.5 py-0.5 text-[0.65rem] tracking-wider uppercase",
                    study.personal
                      ? "border-accent/30 bg-accent-soft text-accent"
                      : "border-line-strong text-muted",
                  ]}
                >
                  {study.badge ?? (study.personal ? "Personal project" : "Confidential")}
                </span>
              </div>
              <p class="mt-1.5 text-sm text-muted">{study.sector}</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-muted">{study.period}</p>
              <p class="mt-1 text-sm text-ink-soft">{study.role}</p>
            </div>
          </header>

          <p class="mt-7 max-w-3xl text-xl leading-snug font-medium text-balance">
            {study.headline}
          </p>

          <div class="mt-8 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
            <div class="space-y-7">
              <div>
                <p class="eyebrow">The problem</p>
                <p class="mt-3 leading-relaxed text-ink-soft">{study.problem}</p>
              </div>

              <div>
                <p class="eyebrow">What I did</p>
                <ul class="mt-3 space-y-2.5">
                  {study.approach.map((item) => (
                    <li class="flex gap-3 leading-relaxed text-ink-soft">
                      <span
                        class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-line-strong"
                        aria-hidden="true"
                      />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <aside class="space-y-7">
              <div class="rounded-xl border border-line bg-surface p-6">
                <p class="eyebrow">Outcome</p>
                <ul class="mt-4 space-y-3">
                  {study.outcome.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-ink">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        class="mt-0.5 shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path
                          d="m5 13 4 4L19 7"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <p class="eyebrow">Stack</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {study.stack.map((tech) => (
                    <li
                      class="rounded-md border border-line bg-surface px-2 py-1 text-[0.7rem] text-ink-soft"
                    >
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>

              {study.links.length > 0 && (
                <div>
                  <p class="eyebrow">Read the code</p>
                  <ul class="mt-3 space-y-1.5">
                    {study.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          rel="noopener"
                          class="text-xs text-accent underline-offset-4 hover:underline"
                        >
                          {link.label} →
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </aside>
          </div>
        </article>
      ))
    }
  </div>

  <CtaBlock
    heading="Want this kind of detail on your own release process?"
    lede="A fixed-scope audit gets you a written assessment of your suite, your pipeline and your release process in a couple of weeks."
  />
</Base>
