---
import { faqs } from "../data/site";

interface Props {
  limit?: number;
}
const { limit } = Astro.props as Props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<div class="mt-12 divide-y divide-line border-y border-line">
  {
    items.map((faq) => (
      <details class="faq reveal group">
        <summary
          class="flex items-start justify-between gap-6 py-5 text-left transition-colors hover:text-accent"
        >
          <h3 class="text-base font-medium md:text-lg">{faq.q}</h3>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            class="faq-chevron mt-1 shrink-0 text-muted transition-transform duration-300"
            aria-hidden="true"
          >
            <path
              d="m6 9 6 6 6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </summary>
        <p class="max-w-3xl pb-6 leading-relaxed text-muted">{faq.a}</p>
      </details>
    ))
  }
</div>
