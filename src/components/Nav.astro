---
import { site, nav, tone } from "../data/site";
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => here === href.replace(/\/$/, "");
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-xl"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="group flex items-center gap-2.5 font-semibold tracking-tight"
      aria-label={`${site.name} — home`}
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-lg border border-accent/30 bg-accent-soft text-[0.7rem] text-accent transition-colors group-hover:border-accent/50"
        aria-hidden="true">LC</span
      >
      <span>{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-lg px-3 py-2 text-sm transition-colors",
              isActive(item.href)
                ? "text-accent"
                : "text-ink-soft hover:bg-surface hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact#book"
        class="hidden rounded-full bg-ink px-4 py-2 text-sm font-semibold text-paper transition hover:bg-ink-soft sm:inline-block"
        >{tone.navCta}</a
      >
      <button
        type="button"
        id="nav-toggle"
        class="grid h-10 w-10 place-items-center rounded-lg border border-line text-ink-soft md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-panel" class="hidden border-t border-line bg-surface md:hidden">
    <nav class="shell flex flex-col py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-lg px-3 py-3 text-sm",
              isActive(item.href) ? "text-accent" : "text-ink-soft",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact#book"
        class="mt-2 rounded-full bg-ink px-4 py-3 text-center text-sm font-semibold text-paper"
        >{tone.navCta}</a
      >
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  })();
</script>
