---
import { site, tone } from "../data/site";

interface Props {
  heading?: string;
  lede?: string;
  compact?: boolean;
}
const {
  heading = "Something in your pipeline is costing you a release",
  lede = tone.closingLede,
  compact = false,
} = Astro.props as Props;

const mailto = `mailto:${site.email}?subject=${encodeURIComponent(
  "SDET / test automation enquiry"
)}&body=${encodeURIComponent(
  "Hi Luis,\n\nWhat we're building:\nWhat's going wrong:\nStack / frameworks:\nRough timeline:\n\n"
)}`;

// Booking and intake links are optional — fall back to email until they're set.
const bookHref = site.booking || mailto;
const bookNote = site.booking
  ? "30 minutes, no pitch"
  : "Email — scheduling link coming soon";
const formHref = site.intakeForm || mailto;
---

<section id="book" class:list={[compact ? "py-16" : "py-24 md:py-28"]}>
  <div class="shell">
    <div
      class="reveal card relative overflow-hidden px-6 py-12 md:px-12 md:py-16"
    >
      <div
        class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-accent/5 blur-3xl"
      >
      </div>

      <div class="relative max-w-2xl">
        <p class="eyebrow">Get in touch</p>
        <h2 class="mt-3 text-title font-semibold tracking-tight text-balance">
          {heading}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{lede}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={bookHref}
            class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition hover:bg-ink-soft"
            >{tone.heroCta}</a
          >
          <a
            href={mailto}
            class="rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition hover:border-ink hover:text-accent"
            >Email me directly</a
          >
        </div>

        <p class="mt-3 text-xs text-muted">{bookNote}</p>

        <div
          class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6 text-sm"
        >
          <a href={formHref} class="text-ink-soft underline-offset-4 hover:text-accent hover:underline"
            >Send project details →</a
          >
          {
            site.resume && (
              <a
                href={site.resume}
                class="text-ink-soft underline-offset-4 hover:text-accent hover:underline"
              >
                Download one-pager (PDF) →
              </a>
            )
          }
          <a
            href={site.github}
            rel="noopener"
            class="text-ink-soft underline-offset-4 hover:text-accent hover:underline"
            >Read my code on GitHub →</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
