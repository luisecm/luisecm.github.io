---
interface Props {
  project: {
    name: string;
    repo: string;
    description: string;
    language: string;
    tags: string[];
    private?: boolean;
    url?: string;
    stars?: number;
    updated?: string | null;
  };
}
const { project } = Astro.props as Props;

// An explicit url wins; otherwise link to GitHub, unless the repo is
// private, in which case render a plain card rather than a dead link.
const href = project.url ?? (project.private ? null : `https://github.com/${project.repo}`);
const isLinked = href !== null;
const Tag = isLinked ? "a" : "div";
const linkProps = isLinked ? { href, rel: "noopener" } : {};
const stars = project.stars ?? 0;
---

<Tag
  {...linkProps}
  class:list={[
    "reveal card group flex flex-col p-7 transition-colors",
    isLinked && "hover:border-accent/40",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <h3
      class:list={[
        "text-base font-medium",
        isLinked ? "text-accent" : "text-ink",
      ]}
    >
      {project.name}
    </h3>

    <div class="flex shrink-0 items-center gap-3">
      {
        stars > 0 && (
          <span class="flex items-center gap-1 text-xs text-muted">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3L7 14.2l-5-4.9 6.9-1Z" />
            </svg>
            {stars}
          </span>
        )
      }
      {
        isLinked ? (
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            class="text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M17 7H8m9 0v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        ) : (
          <span
            class="rounded-full border border-line-strong px-2 py-0.5 text-[0.62rem] tracking-wider text-muted uppercase"
          >
            Private
          </span>
        )
      }
    </div>
  </div>

  <p class="mt-4 flex-1 leading-relaxed text-muted">{project.description}</p>

  <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
    {
      project.tags.map((tag) => (
        <span class="rounded-md border border-line bg-surface px-2 py-0.5 text-[0.68rem] text-muted">
          {tag}
        </span>
      ))
    }
    <span class="text-[0.68rem] text-muted">
      {project.language}{project.updated && ` · updated ${project.updated}`}
    </span>
  </div>
</Tag>
