---
import { site, nav } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-semibold tracking-tight">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
        SDET and test automation consultant. I build the automation and pipelines that
        make releases boring — and ship product features alongside your team.
      </p>
      <p class="mt-4 text-xs text-muted">
        {site.location} · {site.timezone}
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-soft hover:text-accent" href="/">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a class="text-ink-soft hover:text-accent" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="eyebrow">Elsewhere</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="text-ink-soft hover:text-accent" href={`mailto:${site.email}`}
            >{site.email}</a
          >
        </li>
        <li>
          <a
            class="text-ink-soft hover:text-accent"
            href={site.github}
            rel="me noopener">GitHub</a
          >
        </li>

      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="shell flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Built with Astro</p>
    </div>
  </div>
</footer>
